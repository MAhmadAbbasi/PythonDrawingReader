<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Drawing2Quote.Reader</RootNamespace>
    <!-- MuPDF, OpenCV and ONNX Runtime are native: 64-bit Windows -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);CS1591;NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Drawing2Quote.Reader.Tests" />
    <InternalsVisibleTo Include="Drawing2Quote.Service" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDF: the same engine as PyMuPDF (MuPDF) -->
    <PackageReference Include="MuPDF.NET" Version="4.1.0" />
    <!-- geometry: the Java original of GEOS, which shapely runs on -->
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <!-- image processing: OpenCV, as the Python reader's cv2 -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <!-- OCR: the RapidOCR models (PP-OCRv4) on ONNX Runtime, as rapidocr-onnxruntime -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <!-- DXF -->
    <PackageReference Include="ACadSharp" Version="3.8.35" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- block names / legend words -> point types (edit to map your architects' blocks) -->
    <None Include="config\*.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="models\*.onnx" CopyToOutputDirectory="PreserveNewest" />
    <!-- GEOS 3.14.1 (LGPL-2.1), the build shapely ships: the geometry operations are GEOS's own, as in the Python reader -->
    <None Include="native\*.dll;native\LICENSE_GEOS.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
