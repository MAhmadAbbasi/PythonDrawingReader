<?xml version="1.0" encoding="utf-8"?>
<!-- IIS / Plesk site drawingreader.asyntexconsultancy.com: the published Drawing2Quote.Service.exe (64-bit) runs out of
     process (the native libraries need a 64-bit process, whatever the app pool's bitness). Production settings:
     appsettings.Production.json. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- drawings up to 200 MB plus form overhead; IIS refuses bodies over ~28.6 MB by default -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="214958080" />
        </requestFiltering>
      </security>
      <!-- /extract waits for the whole reading (a printed PDF is read with OCR, about a minute a sheet) -->
      <aspNetCore processPath=".\Drawing2Quote.Service.exe" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess" requestTimeout="00:20:00">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
