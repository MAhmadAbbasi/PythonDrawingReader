<?xml version="1.0" encoding="utf-8"?>
<!-- Publish -> Folder: everything the live site needs, in <repo>\publish, ready to upload (FileZilla) to the site
     drawingreader.asyntexconsultancy.com. The server needs the ".NET 8 Hosting Bundle" (64-bit Windows). -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishUrl>D:\Work\Asyntex\ReaderDotnetBuild</PublishUrl>
    <PublishDir>D:\Work\Asyntex\Drawing2Quote\src\Drawing2Quote.Service\Properties\PublishProfiles\..\..\publish\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ProjectGuid>4f0b3dc1-a503-5b94-176f-a95e890af448</ProjectGuid>
  </PropertyGroup>
</Project>