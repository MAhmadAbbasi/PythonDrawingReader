<?xml version="1.0" encoding="utf-8"?>
<!-- IIS / Plesk site abc.asyntexconsultancy.com: every request goes on to the Python service on the same server
     (start-service-production.bat, http://127.0.0.1:8765). Needs IIS URL Rewrite and Application Request Routing
     (ARR) with "Enable proxy" switched on. Copy this file to the site's root folder. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Drawing2Quote" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8765/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- drawings up to 200 MB plus form overhead; IIS refuses bodies over ~28.6 MB by default -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="214958080" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
